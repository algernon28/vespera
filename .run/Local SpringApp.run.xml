<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Local SpringApp" type="SpringBootApplicationConfigurationType" factoryName="Spring Boot">
    <module name="vespera" />
    <option name="PROGRAM_PARAMETERS" value="run" />
    <option name="VM_PARAMETERS" value="-Dspring.config.import=optional:classpath:/application-local.yaml" />
    <option name="ACTIVE_PROFILES" value="local" />
    <!-- Explicit, because vespera.working-dir defaults to ${user.dir}/.vespera: this is what keeps
         the database and profile.yaml at the repo root instead of wherever the IDE last ran from. -->
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="SPRING_BOOT_MAIN_CLASS" value="io.algernon.vespera.VesperaApplication" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
