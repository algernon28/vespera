# The Docling sidecar with LibreOffice, which docling-serve calls to turn .doc and .ppt into
# .docx and .pptx before converting them (ADR-147). No published docling-serve image carries it
# (docs/research/docling-legacy-office.md, section 2), so this repository builds its own.
#
# Writer and Impress, and not Calc: spreadsheets are out of scope (ADR-146), and Calc would be
# installed only to be attacked. On the pinned v1.32.0; the v1.35.0 bump that hardens the
# LibreOffice call is a decision of its own. Keep the base in step with compose.yaml's tag.
#
# The base's own PDF parser, docling-parse 7.16.0, publishes its base fonts to every decoding
# thread before it has filled them, and a fresh process decoding a PDF's pages in parallel can read
# one still empty: 9 crashes, and 21 more conversions losing pages, in 30 cold conversions of a
# synthetic PDF (ADR-163). The layer below replaces it with 7.17.0, the release measured clean,
# pinned so a rebuild can never pick up a different parser unannounced. Keep compose.yaml's tag in
# step with it (ADR-163 §2).
# The CPU base is the default everywhere; compose.gpu.yaml passes the CUDA 12.8 base of the same
# docling-serve release (ADR-170).
ARG DOCLING_SERVE_BASE=quay.io/docling-project/docling-serve-cpu:v1.32.0
FROM ${DOCLING_SERVE_BASE}
USER 0
RUN dnf -y install --nodocs --setopt=install_weak_deps=False \
      libreoffice-core libreoffice-writer libreoffice-impress \
 && dnf -y clean all && rm -rf /var/cache/dnf
USER 1001
RUN pip install --no-cache-dir --no-deps docling-parse==7.17.0 && pip check
