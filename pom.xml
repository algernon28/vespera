<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.algernon</groupId>
    <artifactId>vespera</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>vespera</name>
    <description>vespera</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>26</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <spring-modulith.version>2.1.0</spring-modulith.version>
        <picocli.version>4.7.7</picocli.version>
        <memoryfilesystem.version>2.8.1</memoryfilesystem.version>
        <!--
          Allure is two products on two version lines, which is the easy thing to get wrong.

          allure.version is the adapter: the allure-java libraries the tests are woven with, which
          write target/allure-results. allure-bom below manages every one of them from this number,
          so no Allure dependency carries a version of its own. Its line is 2.x, and there is no 3.x
          release of it.

          allure-report.version is the generator: the TypeScript program that turns those results
          into a page, and the product now at 3.x. Allure 3 reads Allure 2 results, its reader for
          them being part of the generator, so a 2.x adapter with a 3.x generator is the documented
          pairing rather than a mismatch.
        -->
        <allure.version>2.35.4</allure.version>
        <allure-report.version>3.16.0</allure-report.version>
        <allure-maven.version>3.0.3</allure-maven.version>
        <gmavenplus-plugin.version>5.1.0</gmavenplus-plugin.version>
        <groovy.version>5.1.1</groovy.version>
        <aspectj.version>1.9.25.1</aspectj.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <dependency>
            <!--
              The bake-off's reference model is OpenAI (ADR-034). No code in the census slice
              consumes this: the pom carries what a recorded decision requires, ahead of the code
              that uses it (ADR-046), the same way ledger's verdict and run tables exist before
              any stage writes to them.
            -->
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <!-- The profile is YAML, read and written through Jackson's records support (ADR-061). -->
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-chroma</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-chromadb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-ollama</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!--
              An in-memory filesystem for the walk's own logic: the accounting identity, the
              checkpoint ordinals and subtree skipping on resume, and the unprocessable anomaly a
              denied directory produces (ADR-065). It enforces permissions, which is what turns an
              environment-dependent skip into a test, and it builds a thousand-entry tree in
              milliseconds, which is what makes the resume arithmetic testable at a scale that can
              actually break it.

              Not for identity. Its Windows model folds dotless i and I together, where NTFS keeps
              them as different files, which is the exact case ADR-051 was written about. So path
              identity, unencodable names, junctions and traversal order stay on real NTFS under
              @TempDir, and its case-sensitivity settings are deliberately not configured to
              imitate NTFS: a fixture bent to match a belief can only confirm that belief.
            -->
            <groupId>com.github.marschall</groupId>
            <artifactId>memoryfilesystem</artifactId>
            <version>${memoryfilesystem.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <resources>
            <!--
              Declaring resources at all overrides the default, so src/main/resources has to be
              named here too. The second entry carries the file the implementation-versions
              execution below generates (ADR-058); generating it into target/generated-resources and
              letting maven-resources copy it keeps the generation in generate-resources, where a
              generated file belongs, rather than writing into target/classes behind the build's
              back.
            -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources/implementation-versions</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                                <path>
                                    <groupId>org.springframework.boot</groupId>
                                    <artifactId>spring-boot-configuration-processor</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <argLine>-javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"</argLine>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <!--
                  *IT tests need a Docker daemon (VesperaApplicationIT starts Chroma and Ollama via
                  Testcontainers) and are excluded from surefire above, so `./mvnw test` never needs
                  Docker. `./mvnw verify` runs them here, in integration-test, woven the same way as
                  surefire; allure.properties sends both suites to the same results directory,
                  so one report covers the whole build.
                -->
                <artifactId>maven-failsafe-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <argLine>-javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                  Wipes target/allure-results before the tests that refill it. Allure results are
                  append-only and target/ survives between builds, so without this every report
                  aggregates every run since the last clean rather than the run that just happened.

                  Bound to process-test-classes: after a clean would have run, and before surefire,
                  so one report still covers everything a single build executed.

                  excludeDefaultDirectories is essential. Without it this execution deletes all of
                  target/, taking the freshly compiled classes with it.
                -->
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-allure-results</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/allure-results</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure-maven.version}</version>
                <!--
                  Everything this generates goes under target/, so it is disposable and no cleanup
                  step is needed. singleFile is an option of Awesome, the plugin Allure 3 renders
                  the report with, and makes that report one self-contained
                  target/allure-report/index.html; the plugin also renders a Maven site wrapper and
                  the Fluido skin beside it, which cannot be switched off while using the report
                  goal and does not matter once it lands in target/.

                  configPath points at allurerc.mjs, which configures the Awesome plugin (the
                  report UI) and the failure categories. The plugin merges that file underneath
                  its own generated config and overrides only name, output and singleFile, so
                  those three stay here and the rest of the report is described there.

                  reportVersion is pinned deliberately. Left unset, the generator is whatever the
                  plugin currently defaults to, so an unversioned toolchain can change under a build
                  that never changed.
                -->
                <configuration>
                    <reportVersion>${allure-report.version}</reportVersion>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                    <reportDirectory>${project.build.directory}/allure-report</reportDirectory>
                    <singleFile>true</singleFile>
                    <configPath>allurerc.mjs</configPath>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-allure-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                  Copies the report to reports/report_<datetime>.html, so the one file worth
                  opening or sending is out of target/, survives a clean, and says which run
                  produced it. Nothing here deletes an older report: every run's file gets its
                  own name, so none is ever overwritten, and reports/ is left to grow with one
                  file per run. singleFile above means there is exactly one file to copy; the
                  Maven site wrapper allure-maven renders beside it stays behind in target/.

                  Neither core Maven plugin does a rename: maven-resources-plugin only places a
                  file under its source name, and maven-antrun-plugin means mixing Ant into a
                  Maven build for a one-line job. gmavenplus runs the rename as a few lines of
                  Groovy instead, with no separate script file and no second build tool.

                  The stamp is computed here rather than read from maven.build.timestamp: that
                  property is not exposed on project.properties in this Maven version, and
                  computing it directly also means it is the JVM's local time, not Maven's UTC.

                  Declared after allure-maven and bound to the same phase, because plugins bound
                  to one phase run in declaration order: the report has to exist before it is
                  copied.
                -->
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>${gmavenplus-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy</artifactId>
                        <version>${groovy.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <!--
                          Stamps each module with the commit that last touched it (ADR-058). The
                          script says why, and is a .groovy file rather than CDATA so that an editor
                          can read it as code.
                        -->
                        <id>implementation-versions</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <scripts>
                                <!--suppress UnresolvedMavenProperty -->
                                <script>file:///${project.basedir}/.mvn/scripts/implementation-versions.groovy</script>
                            </scripts>
                        </configuration>
                    </execution>
                    <execution>
                        <id>publish-allure-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <scripts>
                                <!--suppress UnresolvedMavenProperty -->
                                <script>file:///${project.basedir}/.mvn/scripts/publish-allure-report.groovy</script>
                            </scripts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
