{
  "type": "object",
  "description": "The format mix, written beside format-mix.html by the byte-level reduction step (ADR-362 section 9): what its page shows, as data.",
  "properties": {
    "format": {
      "const": 1,
      "description": "The format of this file, raised when a field is removed, renamed or changed in meaning or type."
    },
    "analysisReport": {
      "type": "string",
      "const": "format-mix",
      "description": "The report's name."
    },
    "title": {
      "type": "string",
      "description": "The page's title."
    },
    "writtenAt": {
      "type": "string",
      "description": "The instant it was written, ISO 8601 in UTC with Z, to the millisecond."
    },
    "headline": {
      "type": "array",
      "description": "The few numbers the page states first: files, out-of-scope, logs, too-large and code, each a count.",
      "items": {
        "type": "object",
        "description": "One figure.",
        "properties": {
          "key": {
            "type": "string",
            "description": "Its key, one of files, out-of-scope, logs, too-large and code.",
            "enum": [
              "files",
              "out-of-scope",
              "logs",
              "too-large",
              "code"
            ]
          },
          "label": {
            "type": "string",
            "description": "Its label."
          },
          "value": {
            "type": "integer",
            "description": "Its value."
          },
          "unit": {
            "type": "string",
            "description": "Its unit; a count here.",
            "enum": [
              "count",
              "share",
              "bytes",
              "seconds",
              "number"
            ]
          }
        },
        "required": [
          "key",
          "label",
          "value",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "description": "The page's parts in its order, by the ids the id field names: what-the-files-were, by-kind, nothing-could-be-read, finer-labels, kept-as-code, name-endings, name-endings-caution, timestamp-share, settings-share, settings-roots, settings-interface-definitions, unrecognised and cannot-see.",
      "items": {
        "type": "object",
        "description": "One part of the page.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Its id.",
            "enum": [
              "what-the-files-were",
              "by-kind",
              "nothing-could-be-read",
              "finer-labels",
              "kept-as-code",
              "name-endings",
              "name-endings-caution",
              "timestamp-share",
              "settings-share",
              "settings-roots",
              "settings-interface-definitions",
              "unrecognised",
              "cannot-see"
            ]
          },
          "title": {
            "type": "string",
            "description": "Its title."
          },
          "text": {
            "type": "array",
            "description": "Its paragraphs, in plain text.",
            "items": {
              "type": "string",
              "description": "A paragraph."
            }
          },
          "chart": {
            "type": [
              "object",
              "null"
            ],
            "description": "Its chart, drawn from the columns of its table; null where it has none. Held by by-kind, timestamp-share and settings-share, each a bars chart of the files by the first column.",
            "properties": {
              "kind": {
                "type": "string",
                "description": "bars or lines.",
                "enum": [
                  "bars",
                  "lines"
                ]
              },
              "x": {
                "type": "string",
                "description": "The id of the column the chart is drawn along.",
                "enum": [
                  "kind",
                  "files",
                  "within",
                  "named-as",
                  "source",
                  "ending",
                  "band",
                  "first-element",
                  "definition",
                  "begins-with"
                ]
              },
              "series": {
                "type": "array",
                "description": "The ids of the columns it draws.",
                "items": {
                  "type": "string",
                  "description": "A column's id.",
                  "enum": [
                    "kind",
                    "files",
                    "within",
                    "named-as",
                    "source",
                    "ending",
                    "band",
                    "first-element",
                    "definition",
                    "begins-with"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "x",
              "series"
            ],
            "additionalProperties": false
          },
          "table": {
            "type": [
              "object",
              "null"
            ],
            "description": "Its table; null where it has none. The first column of each is a column of text and the last a column of counts: kind and files for by-kind, within, named-as and files for finer-labels, source and files for kept-as-code, ending and files for name-endings, band and files for timestamp-share and settings-share, first-element and files for settings-roots, definition and files for settings-interface-definitions, and begins-with and files for unrecognised.",
            "properties": {
              "columns": {
                "type": "array",
                "description": "Its columns, in order.",
                "items": {
                  "type": "object",
                  "description": "One column.",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Its id.",
                      "enum": [
                        "kind",
                        "files",
                        "within",
                        "named-as",
                        "source",
                        "ending",
                        "band",
                        "first-element",
                        "definition",
                        "begins-with"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "description": "Its heading."
                    },
                    "kind": {
                      "type": "string",
                      "description": "What its cells hold: text or count here.",
                      "enum": [
                        "text",
                        "count",
                        "share",
                        "number",
                        "bytes",
                        "seconds",
                        "instant",
                        "path",
                        "analysisReport"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "kind"
                  ],
                  "additionalProperties": false
                }
              },
              "rows": {
                "type": "array",
                "description": "Its rows, in the page's order.",
                "items": {
                  "type": "array",
                  "description": "One row: a cell for each column, in the columns' order.",
                  "items": {
                    "description": "A cell: a string for a text column, an integer for a count."
                  }
                }
              }
            },
            "required": [
              "columns",
              "rows"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "text",
          "chart",
          "table"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "analysisReport",
    "title",
    "writtenAt",
    "headline",
    "sections"
  ],
  "additionalProperties": false
}
