{
  "type": "object",
  "description": "The invocation report, report.json (ADR-362 section 3), format 1.",
  "properties": {
    "format": {
      "const": 1,
      "description": "The report's format, the integer InvocationReport.FORMAT holds; raised by a change that removes, renames or retypes a field."
    },
    "vespera": {
      "type": [
        "string",
        "null"
      ],
      "description": "The jar's version, as its manifest names it; null where the process does not run from the jar."
    },
    "invocation": {
      "type": "object",
      "description": "The invocation this report is about.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The start in UTC as yyyyMMdd'T'HHmmss'Z', with -2 and on for a second in the same second; names the copy in logs."
        },
        "pid": {
          "type": "integer",
          "description": "The process's own id."
        },
        "command": {
          "type": "string",
          "description": "The command: run, label, label --auto or publish.",
          "enum": [
            "run",
            "label",
            "label --auto",
            "publish"
          ]
        },
        "started": {
          "type": "string",
          "description": "The instant the command began to run, in UTC to the millisecond."
        },
        "ended": {
          "type": [
            "string",
            "null"
          ],
          "description": "The instant it ended; null while running."
        },
        "state": {
          "type": "string",
          "description": "running or ended.",
          "enum": [
            "running",
            "ended"
          ]
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ],
          "description": "How it ended: completed, failed or stopped for run; recorded, refused or failed for label; delivered or stopped for publish; refused for a refusal; null while running.",
          "enum": [
            "completed",
            "failed",
            "stopped",
            "recorded",
            "refused",
            "delivered",
            null
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The exit code; null while running."
        },
        "writtenAt": {
          "type": "string",
          "description": "The instant of this write."
        },
        "interval": {
          "type": "integer",
          "description": "The seconds between writes while the job runs."
        }
      },
      "required": [
        "id",
        "pid",
        "command",
        "started",
        "ended",
        "state",
        "outcome",
        "exitCode",
        "writtenAt",
        "interval"
      ],
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "description": "Whether a display is present where this process runs, and why.",
      "properties": {
        "present": {
          "type": "boolean",
          "description": "Whether a display is present."
        },
        "reason": {
          "type": "string",
          "description": "The reason, from a closed list.",
          "enum": [
            "window-server",
            "no-window-server",
            "visible-window-station",
            "hidden-window-station",
            "display-variable",
            "no-display-variable",
            "headless",
            "not-answered"
          ]
        }
      },
      "required": [
        "present",
        "reason"
      ],
      "additionalProperties": false
    },
    "opened": {
      "type": [
        "object",
        "null"
      ],
      "description": "What the invocation opened; null in every report written before the commands open nothing.",
      "properties": {
        "files": {
          "type": "array",
          "description": "The files opened.",
          "items": {
            "type": "string",
            "description": "A file opened."
          }
        },
        "because": {
          "type": "string",
          "description": "Why nothing was opened.",
          "enum": [
            "commands-open-nothing",
            "no-display"
          ]
        }
      },
      "required": [
        "files",
        "because"
      ],
      "additionalProperties": false
    },
    "places": {
      "type": "object",
      "description": "The folders the invocation was given.",
      "properties": {
        "workingDirectory": {
          "type": "string",
          "description": "The working directory, absolute."
        },
        "corpusRoot": {
          "type": [
            "string",
            "null"
          ],
          "description": "The root run walks; null for other commands."
        },
        "deliverableRoot": {
          "type": [
            "string",
            "null"
          ],
          "description": "The root the tree is drawn at where this invocation drew one; else null."
        }
      },
      "required": [
        "workingDirectory",
        "corpusRoot",
        "deliverableRoot"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "description": "Each step of the job, in the order the job runs them; empty for label and publish.",
      "items": {
        "type": "object",
        "description": "One step of the job.",
        "properties": {
          "name": {
            "type": "string",
            "description": "The step's name."
          },
          "stage": {
            "type": "string",
            "description": "The stage under whose runs the job records the step's completion; 0, 5e and 5 for the census, the relevance floor and the relevance report."
          },
          "leg": {
            "type": "string",
            "description": "The leg the step is drawn in."
          },
          "state": {
            "type": "string",
            "description": "The step's state.",
            "enum": [
              "not started",
              "running",
              "finished",
              "stopped at a gate",
              "failed"
            ]
          },
          "read": {
            "type": "integer",
            "description": "Rows read."
          },
          "written": {
            "type": "integer",
            "description": "Rows written."
          },
          "skipped": {
            "type": "integer",
            "description": "Rows skipped."
          },
          "started": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the step started; null before."
          },
          "ended": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the step ended; null before."
          },
          "seconds": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Whole seconds the step has taken; null before it starts."
          },
          "progress": {
            "type": [
              "object",
              "null"
            ],
            "description": "The last progress line the step logged, with its counter.",
            "properties": {
              "line": {
                "type": "string",
                "description": "The progress line, whole."
              },
              "done": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How far the counter has got; null where the line has none."
              },
              "total": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The counter's total; null where it has none."
              }
            },
            "required": [
              "line",
              "done",
              "total"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "stage",
          "leg",
          "state",
          "read",
          "written",
          "skipped",
          "started",
          "ended",
          "seconds",
          "progress"
        ],
        "additionalProperties": false
      }
    },
    "legs": {
      "type": "array",
      "description": "The four legs.",
      "items": {
        "type": "object",
        "description": "One leg.",
        "properties": {
          "name": {
            "type": "string",
            "description": "The leg's name."
          },
          "state": {
            "type": "string",
            "description": "The leg's state.",
            "enum": [
              "not started",
              "running",
              "finished",
              "stopped at a gate",
              "failed"
            ]
          },
          "open": {
            "type": "boolean",
            "description": "Whether the leg is drawn open."
          }
        },
        "required": [
          "name",
          "state",
          "open"
        ],
        "additionalProperties": false
      }
    },
    "removing": {
      "type": [
        "object",
        "null"
      ],
      "description": "The step removing occurrences now or last; null before one has.",
      "properties": {
        "step": {
          "type": "string",
          "description": "The step."
        },
        "entered": {
          "type": "integer",
          "description": "What entered it."
        },
        "survivors": {
          "type": "integer",
          "description": "Its survivors now."
        },
        "verdicts": {
          "type": "object",
          "description": "Verdicts by kind that step records.",
          "properties": {
            "broken": {
              "type": "integer",
              "description": "The figure for broken."
            },
            "duplicate-of": {
              "type": "integer",
              "description": "The figure for duplicate-of."
            },
            "superseded-by": {
              "type": "integer",
              "description": "The figure for superseded-by."
            },
            "out-of-scope": {
              "type": "integer",
              "description": "The figure for out-of-scope."
            },
            "code": {
              "type": "integer",
              "description": "The figure for code."
            },
            "extraction-failed": {
              "type": "integer",
              "description": "The figure for extraction-failed."
            },
            "degenerate-output": {
              "type": "integer",
              "description": "The figure for degenerate-output."
            },
            "redundant-with": {
              "type": "integer",
              "description": "The figure for redundant-with."
            },
            "translation-of": {
              "type": "integer",
              "description": "The figure for translation-of."
            },
            "below-threshold": {
              "type": "integer",
              "description": "The figure for below-threshold."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "perMinute": {
          "type": "object",
          "description": "Verdicts per minute by kind over the last ten minutes; empty where no rate is measured yet.",
          "properties": {
            "broken": {
              "type": "number",
              "description": "The figure for broken."
            },
            "duplicate-of": {
              "type": "number",
              "description": "The figure for duplicate-of."
            },
            "superseded-by": {
              "type": "number",
              "description": "The figure for superseded-by."
            },
            "out-of-scope": {
              "type": "number",
              "description": "The figure for out-of-scope."
            },
            "code": {
              "type": "number",
              "description": "The figure for code."
            },
            "extraction-failed": {
              "type": "number",
              "description": "The figure for extraction-failed."
            },
            "degenerate-output": {
              "type": "number",
              "description": "The figure for degenerate-output."
            },
            "redundant-with": {
              "type": "number",
              "description": "The figure for redundant-with."
            },
            "translation-of": {
              "type": "number",
              "description": "The figure for translation-of."
            },
            "below-threshold": {
              "type": "number",
              "description": "The figure for below-threshold."
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "step",
        "entered",
        "survivors",
        "verdicts",
        "perMinute"
      ],
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "description": "The working directory's database.",
      "properties": {
        "bytes": {
          "type": "integer",
          "description": "vespera.db and vespera.db-wal added, in bytes."
        }
      },
      "required": [
        "bytes"
      ],
      "additionalProperties": false
    },
    "charts": {
      "type": "array",
      "description": "The three charts of the progress page, at most 256 samples.",
      "items": {
        "type": "object",
        "description": "One chart.",
        "properties": {
          "id": {
            "type": "string",
            "description": "The chart's id.",
            "enum": [
              "database",
              "counts",
              "verdicts"
            ]
          },
          "title": {
            "type": "string",
            "description": "Its title."
          },
          "axis": {
            "type": "string",
            "description": "Its value axis."
          },
          "seconds": {
            "type": "array",
            "description": "Elapsed seconds of each sample.",
            "items": {
              "type": "integer",
              "description": "A sample's second."
            }
          },
          "lines": {
            "type": "array",
            "description": "Its lines.",
            "items": {
              "type": "object",
              "description": "One line.",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The line's name."
                },
                "values": {
                  "type": "array",
                  "description": "Its value at each sample.",
                  "items": {
                    "type": "number",
                    "description": "A value."
                  }
                }
              },
              "required": [
                "name",
                "values"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "axis",
          "seconds",
          "lines"
        ],
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "object",
      "description": "The runs the working directory holds, read at the invocation's start and end.",
      "properties": {
        "read": {
          "type": "string",
          "description": "none before the first reading, start, end, or failed where the reading failed.",
          "enum": [
            "none",
            "start",
            "end",
            "failed"
          ]
        },
        "rows": {
          "type": "array",
          "description": "Each run in order.",
          "items": {
            "type": "object",
            "description": "One run.",
            "properties": {
              "walk": {
                "type": "integer",
                "description": "Its walk."
              },
              "stage": {
                "type": "string",
                "description": "Its stage."
              },
              "ordinal": {
                "type": "integer",
                "description": "Its ordinal among the runs of its walk and stage."
              },
              "stepsFinished": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many of its steps finished; null where the stage has none."
              },
              "stepsOf": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many steps record under it; null where none."
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "finished or not finished; null where the stage has no step.",
                "enum": [
                  "finished",
                  "not finished",
                  null
                ]
              },
              "thisInvocation": {
                "type": "boolean",
                "description": "Whether this invocation minted or continued it."
              },
              "verdicts": {
                "type": "object",
                "description": "Verdicts it holds by kind.",
                "properties": {
                  "broken": {
                    "type": "integer",
                    "description": "The figure for broken."
                  },
                  "duplicate-of": {
                    "type": "integer",
                    "description": "The figure for duplicate-of."
                  },
                  "superseded-by": {
                    "type": "integer",
                    "description": "The figure for superseded-by."
                  },
                  "out-of-scope": {
                    "type": "integer",
                    "description": "The figure for out-of-scope."
                  },
                  "code": {
                    "type": "integer",
                    "description": "The figure for code."
                  },
                  "extraction-failed": {
                    "type": "integer",
                    "description": "The figure for extraction-failed."
                  },
                  "degenerate-output": {
                    "type": "integer",
                    "description": "The figure for degenerate-output."
                  },
                  "redundant-with": {
                    "type": "integer",
                    "description": "The figure for redundant-with."
                  },
                  "translation-of": {
                    "type": "integer",
                    "description": "The figure for translation-of."
                  },
                  "below-threshold": {
                    "type": "integer",
                    "description": "The figure for below-threshold."
                  }
                },
                "required": [
                  "broken",
                  "duplicate-of",
                  "superseded-by",
                  "out-of-scope",
                  "code",
                  "extraction-failed",
                  "degenerate-output",
                  "redundant-with",
                  "translation-of",
                  "below-threshold"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "walk",
              "stage",
              "ordinal",
              "stepsFinished",
              "stepsOf",
              "state",
              "thisInvocation",
              "verdicts"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "read",
        "rows"
      ],
      "additionalProperties": false
    },
    "arrivedAt": {
      "type": "array",
      "description": "The runs this invocation minted or continued.",
      "items": {
        "type": "object",
        "description": "One run.",
        "properties": {
          "stage": {
            "type": "string",
            "description": "Its stage."
          },
          "run": {
            "type": "string",
            "description": "Its id."
          }
        },
        "required": [
          "stage",
          "run"
        ],
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "description": "Each step shown stopped at a gate.",
      "items": {
        "type": "object",
        "description": "One gate.",
        "properties": {
          "step": {
            "type": "string",
            "description": "The step."
          },
          "key": {
            "type": [
              "string",
              "null"
            ],
            "description": "The profile value whose absence shut it; null where none did."
          },
          "analysisReports": {
            "type": "array",
            "description": "The analysis reports that key is read off.",
            "items": {
              "type": "string",
