<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-093. Two appenders, both always on: console for interactive use, and a rolling file in the
  configured working directory's logs folder (ADR-054, ADR-270) so a multi-day unattended run (ADR-035
  runs the pipeline unattended through 6b) leaves something to read afterward. Logback makes the folder. One continuously-rotating file, not one per run/walk (ADR-055 resumes a walk under
  one id across invocations) — correlation across lines is by run/walk/occurrence id in the message
  text, not by filename.

  ADR-364. The jar's own lines (refusals, closing lines, the lines of label and publish) go through the logger
  io.algernon.vespera.operator, which reads on the stream as their words alone and is in vespera.log as well; the
  invocation's output file, logs/output-<invocation>.log, joins the console and vespera.log in a later step.

  ${vespera.working-dir} is the same Spring property WorkingDirectoryPreparer resolves and the
  application's own beans (@Value("${vespera.working-dir}")) read; Logback's Spring extension exposes
  it here via springProperty so this file needs no separate configuration of its own.
-->
<configuration>

    <springProperty scope="context" name="workingDir" source="vespera.working-dir" defaultValue="."/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${workingDir}/logs/vespera.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${workingDir}/logs/vespera.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      #579. The command's closing line is the last line it prints (ADR-158, ADR-278). Two library loggers
      write after it at INFO: Hikari's pool shutdown while SpringApplication.exit closes the context, and
      Spring Batch's launcher's line on the job's end, after a failed step's closing line. On the console
      they are held to WARN; the file keeps them at INFO, as it keeps every line (ADR-270).
    -->
    <appender name="CONSOLE_WARN" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.zaxxer.hikari" additivity="false">
        <appender-ref ref="CONSOLE_WARN"/>
        <appender-ref ref="FILE"/>
    </logger>

    <logger name="org.springframework.batch.core.launch.support.TaskExecutorJobLauncher" additivity="false">
        <appender-ref ref="CONSOLE_WARN"/>
        <appender-ref ref="FILE"/>
    </logger>


    <!--
      ADR-364 section 4. The jar's own lines, its refusals, its closing lines and the lines of label and publish,
      are logged on a logger of their own and read, on the stream, as their words alone: a line printed on standard
      output is logged at INFO and one printed on standard error at WARN, and a closing line logged at ERROR is on
      standard error. The charsets are the streams' own, so the bytes of a line on a console that is not UTF-8 are
      what println wrote. The logger is at INFO whatever the level of its parents, and adds to none of them.
    -->
    <appender name="OPERATOR" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <encoder>
            <charset>${stdout.encoding:-UTF-8}</charset>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <appender name="OPERATOR_WARN" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <charset>${stderr.encoding:-UTF-8}</charset>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.algernon.vespera.operator" level="INFO" additivity="false">
        <appender-ref ref="OPERATOR"/>
        <appender-ref ref="OPERATOR_WARN"/>
        <appender-ref ref="FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
