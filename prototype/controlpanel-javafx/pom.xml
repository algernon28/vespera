<?xml version="1.0" encoding="UTF-8"?>
<!--
  PROTOTYPE, throwaway. Not a module of the main build: the root pom does not name it,
  so `./mvnw test` never compiles it. It lives on the `javafx` branch only.
  Run:  ./mvnw -f prototype/controlpanel-javafx/pom.xml javafx:run [-Dvariant=B]
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.algernon</groupId>
    <artifactId>controlpanel-javafx-prototype</artifactId>
    <version>0-PROTOTYPE</version>

    <properties>
        <maven.compiler.release>26</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>26.0.2</javafx.version>
        <variant>A</variant>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>io.algernon.controlpanel.prototype.Prototype</mainClass>
                    <commandlineArgs>${variant}</commandlineArgs>
                    <options>
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
